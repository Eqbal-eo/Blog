# Copy to .env and fill in. Never commit the real file.

# Supabase (Project Settings > API Keys)
SUPABASE_URL=https://your-project.supabase.co
# Secret service_role key. Server only: it bypasses row level security.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Signs the session cookie and password reset links. Any long random string.
JWT_SECRET=your_long_random_secret

# Brevo SMTP (sends invite codes, login details, password resets, newsletter)
BREVO_USER=your_login@smtp-brevo.com
BREVO_SMTP_KEY=your_brevo_smtp_key
BREVO_SENDER_EMAIL=no-reply@yourdomain.com
# Receives "new blog request" alerts
ADMIN_EMAIL=you@yourdomain.com

# Public URL of the site, used in email links and page metadata
WEBSITE_URL=https://yourdomain.com

# Writing assistant (Arabic proofreading, title and summary ideas).
# Optional: without it the assistant is hidden. https://console.anthropic.com
ANTHROPIC_API_KEY=

# Public demo account, shown on the login page. Create it once with:
#   node --env-file=.env scripts/create-demo-account.mjs
DEMO_PASSWORD=

# Protects the daily demo reset (/api/cron/reset-demo). Vercel Cron sends it
# automatically once set in the project's environment variables.
CRON_SECRET=

# Error monitoring with Sentry (optional; inactive when empty)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Only for uploading source maps at build time
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
